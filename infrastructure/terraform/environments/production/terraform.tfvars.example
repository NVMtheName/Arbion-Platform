aws_region          = "us-east-1"
availability_zones  = ["us-east-1a", "us-east-1b"]
# DNS remains untouched unless BOTH an existing zone ID is supplied and this is true.
manage_dns_records = false
route53_zone_id    = null
# image_tag must be an immutable Git SHA after the initial repositories are populated.
image_tag = "bootstrap"
