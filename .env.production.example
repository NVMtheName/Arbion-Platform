# Copy to .env.production on the host and replace every blank value.
ARBION_ENV=production
# Enable only after migration 00012 is applied and the guarded scheduler checks pass.
NONLIVE_SCHEDULER_ENABLED=false
POSTGRES_DB=arbion
POSTGRES_USER=arbion
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
AUTH_SESSION_COOKIE=arbion_session
AUTH_SESSION_TTL=12h
AUTH_ALLOWED_ORIGINS=https://www.arbion.ai
# Comma-separated normalized addresses. Blank denies all production registration.
REGISTRATION_ALLOWLIST=
EMAIL_DELIVERY_MODE=disabled
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_PUBLIC_BASE_URL=https://www.arbion.ai
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Arbion
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=30m
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FOUNDER_EMAIL=
CREDENTIAL_ENCRYPTION_KEY=
AI_INTERNAL_SERVICE_TOKEN=
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://www.arbion.ai/api/connections/financial/schwab/callback

# AWS ECS may inject these fields independently instead of DATABASE_URL.
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_NAME=arbion
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_SSLMODE=require
