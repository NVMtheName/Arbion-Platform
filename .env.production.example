# Copy to .env.production on the host and replace every blank value.
ARBION_ENV=production
POSTGRES_DB=arbion
POSTGRES_USER=arbion
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
AUTH_SESSION_COOKIE=arbion_session
AUTH_SESSION_TTL=12h
AUTH_ALLOWED_ORIGINS=https://www.arbion.ai
FOUNDER_EMAIL=
CREDENTIAL_ENCRYPTION_KEY=
AI_INTERNAL_SERVICE_TOKEN=
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://www.arbion.ai/api/connections/financial/schwab/callback
