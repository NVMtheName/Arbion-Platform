[Unit]
Description=Check Arbion production container health
Requires=docker.service
After=docker.service
OnFailure=arbion-ops-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
Environment=DOCKER_CONFIG=/run/arbion-production-containers
RuntimeDirectory=arbion-production-containers
RuntimeDirectoryMode=0700
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ExecStart=/opt/arbion/scripts/check-production-containers.sh
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/arbion
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
NoNewPrivileges=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
