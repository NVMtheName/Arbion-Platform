[Unit]
Description=Check Arbion host memory pressure
OnFailure=arbion-ops-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
Environment=ARBION_MEMORY_AVAILABLE_THRESHOLD_PERCENT=10
ExecStart=/opt/arbion/scripts/check-memory-pressure.sh
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/arbion /proc/meminfo
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
NoNewPrivileges=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
