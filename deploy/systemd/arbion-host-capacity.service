[Unit]
Description=Check Arbion host filesystem capacity
OnFailure=arbion-ops-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
Environment=ARBION_CAPACITY_PATH=/var/lib/docker
Environment=ARBION_CAPACITY_THRESHOLD_PERCENT=85
ExecStart=/opt/arbion/scripts/check-host-capacity.sh
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/arbion /var/lib/docker
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
NoNewPrivileges=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
