PORT=8080
ARBION_ENV=development
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_URL=postgres://arbion:local-development-only@localhost:5432/arbion?sslmode=disable
REDIS_URL=redis://localhost:6379/0
AUTH_SESSION_COOKIE=arbion_session
AUTH_SESSION_TTL=12h
AUTH_ALLOWED_ORIGINS=http://localhost:3000
FOUNDER_EMAIL=
CREDENTIAL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_SERVICE_TOKEN=local-internal-development-token
