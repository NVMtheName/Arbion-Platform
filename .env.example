POSTGRES_DB=arbion
POSTGRES_USER=arbion
POSTGRES_PASSWORD=local-development-only
API_PORT=8080
AI_PORT=8000
WEB_PORT=3000
ARBION_ENV=development
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_URL=postgres://arbion:local-development-only@postgres:5432/arbion?sslmode=disable
REDIS_URL=redis://redis:6379/0
AUTH_SESSION_COOKIE=arbion_session
AUTH_SESSION_TTL=12h
AUTH_ALLOWED_ORIGINS=http://localhost:3000
REGISTRATION_ALLOWLIST=
FOUNDER_EMAIL=
CREDENTIAL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
API_BASE_URL=http://api:8080
AI_BASE_URL=http://ai:8000
AI_SERVICE_URL=http://ai:8000
AI_INTERNAL_SERVICE_TOKEN=local-internal-development-token
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=http://localhost:8080/api/connections/financial/schwab/callback
SCHWAB_AUTHORIZATION_URL=https://api.schwabapi.com/v1/oauth/authorize
SCHWAB_TOKEN_URL=https://api.schwabapi.com/v1/oauth/token
SCHWAB_TRADER_BASE_URL=https://api.schwabapi.com/trader/v1
SCHWAB_MARKET_DATA_BASE_URL=https://api.schwabapi.com/marketdata/v1
